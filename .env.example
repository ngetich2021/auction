# Auth.js (next-auth v5)
AUTH_SECRET=
NEXTAUTH_URL=

# Google OAuth — redirect URI in Google Cloud Console must be
# https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudinary (image/video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (order/advert notification emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Turso (libsql) — the only database this app reads/writes at runtime
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# M-Pesa Daraja
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=
# Must be a stable, publicly reachable HTTPS URL Safaricom can POST to.
# Set this to https://<your-domain> once deployed — the app appends
# /api/mpesa/callback itself.
MPESA_CALLBACK_URL=
